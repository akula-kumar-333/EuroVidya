{
  "entities": {
    "UserDossier": {
      "title": "UserDossier",
      "description": "Cloud-persisted student profile, grade calculation inputs, liked items, shortlisted programs, checklist readiness, and blocked account inputs.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "email": { "type": "string", "minLength": 0, "maxLength": 160 },
        "targetDegree": { "type": "string", "enum": ["Bachelors", "Masters", ""] },
        "targetField": { "type": "string", "maxLength": 80 },
        "gradingScale": { "type": "string", "enum": ["cgpa10", "gpa4", "percentage", ""] },
        "maxScore": { "type": "number" },
        "minPassScore": { "type": "number" },
        "obtainedScore": { "type": "number" },
        "degreeDuration": { "type": "number" },
        "ieltsScore": { "type": "number" },
        "germanLevel": { "type": "string", "enum": ["None", "A1", "A2", "B1", "B2", "C1", ""] },
        "backlogs": { "type": "number" },
        "apsStatus": { "type": "string", "enum": ["Not Started", "Applied", "Verified", ""] },
        "shortlistedIds": { "type": "array" },
        "likedItemIds": { "type": "array" },
        "checklistState": { "type": "object" },
        "blockedAccount": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "studentName",
        "email",
        "targetDegree",
        "targetField",
        "gradingScale",
        "maxScore",
        "minPassScore",
        "obtainedScore",
        "degreeDuration",
        "ieltsScore",
        "germanLevel",
        "backlogs",
        "apsStatus",
        "shortlistedIds",
        "likedItemIds",
        "checklistState",
        "blockedAccount",
        "updatedAt"
      ]
    },
    "ConsultationInquiry": {
      "title": "ConsultationInquiry",
      "description": "Student or parent consultation submission from the EuroVidya Contact Us page.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "applicantRole": { "type": "string", "enum": ["Student", "Parent / Guardian", "Both Attending"] },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 32 },
        "destinationCountry": {
          "type": "string",
          "enum": ["Germany", "France", "Ireland", "Netherlands", "Austria", "Multiple European Countries"]
        },
        "targetIntake": { "type": "string", "minLength": 3, "maxLength": 60 },
        "preferredCounselor": {
          "type": "string",
          "enum": [
            "General Advisory (info@eurovidya.com)",
            "Kumar Swamy (kumarswamy@eurovidya.com)",
            "Sanjay (sanjay@eurovidya.com)"
          ]
        },
        "message": { "type": "string", "minLength": 0, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "studentName",
        "applicantRole",
        "email",
        "phone",
        "destinationCountry",
        "targetIntake",
        "preferredCounselor",
        "message",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/dossier/{docId}": {
      "schema": { "$ref": "#/entities/UserDossier" },
      "description": "Per-user private student shortlist, likes, profile, and readiness state."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ConsultationInquiry" },
      "description": "Student and parent consultation inquiries submitted via the Contact Us page."
    }
  }
}
